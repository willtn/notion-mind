.DS_Store
.Trash/

# Claude Code. The re-include guard protects against user-level global
# gitignores that exclude .claude/ (a cache-dir convention in other tools) —
# without it, the entire hook/command/skill layer silently drops out of
# version control. Repo-level patterns override global excludes.
!.claude/
.claude/settings.local.json

# Session logs (local transcripts)
thinking/session-logs/

# Node typecheck deps (CI + local dev only; runtime is zero-deps)
node_modules/
.claude/scripts/node_modules/

# The Claude Code mod: the session context it delivers (rewritten every
# session, read through /memory), and the typings and tsconfig Claude Code
# writes into a mod folder when it is loaded for development.
.claude/session-context.md
.claude/skills/obsidian-mind/.claude-plugin/types/
.claude/skills/obsidian-mind/tsconfig.json

# Hook runtime state (local, self-pruning)
.claude/scripts/.hint-state.json
.claude/scripts/.checklist-state.json
.claude/scripts/.stop-handoff/

# Local state outside the note store. The outbox holds the JSON arguments of a
# Notion write until the write hook removes them.
.claude/state/

# The Notion IDs of the content model, written by notion-setup.ts. The
# repository is public, so only notion-map.example.json is committed.
notion-map.json
notion-map.fixtures.json
