{
  "template": "obsidian-mind",
  "version": "10.0.0",
  "released": "2026-10-12",
  "open_loop_types": [
    "1:1",
    "Inbox item",
    "Incident"
  ],
  "open_loop_sections": [
    "action items",
    "what to watch"
  ],
  "eager_layer_budget_bytes": 9000,
  "eager_layer_instruction_budget_bytes": 20000,
  "listing_collapse_threshold": 12,
  "frontmatter_required": {
    "global": [
      "date",
      "description",
      "tags"
    ],
    "work-note": [
      "date",
      "status",
      "quarter"
    ],
    "incident": [
      "date",
      "status",
      "quarter",
      "ticket",
      "severity",
      "role"
    ],
    "person": [
      "date",
      "title"
    ],
    "team": [
      "date"
    ],
    "1-1": [
      "date",
      "quarter"
    ]
  }
}
